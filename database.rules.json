// えいごクエスト Realtime Database セキュリティルール。
// main に push すると .github/workflows/firebase-rules.yml が自動デプロイ（手動貼り付け不要）。
// ・生徒は自分のデータ(students/自分のUID)だけ読み書き可。他人のは不可。
// ・辞書リクエスト(wordRequests)は公開一覧にしない。ログインは求めず、
//   《見出し語そのものがキー＝同じ語は1件だけ》と《全体の受付上限2000語》で守る。
// ・既存エントリの変更・削除、未知のフィールド、長すぎる値は拒否する。
// ・上限カウンタ(wordRequestQuota/used)は整数1つだけ。+1ずつしか動かせない。
{
  "rules": {
    "students": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "wordRequests": {
      ".read": false,
      "$word": {
        ".write": "!data.exists() && newData.exists() && (!root.child('wordRequestQuota/used').exists() || root.child('wordRequestQuota/used').val() < 2000)",
        ".validate": "newData.hasChildren(['word','q','ts','source']) && newData.child('word').val() === $word",
        "word": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64 && newData.val().matches(/^[a-z]+([-'][a-z]+)*$/)"
        },
        "q": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64 && newData.val().matches(/^[A-Za-z]+([-'][A-Za-z]+)*$/)"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
        },
        "source": {
          ".validate": "newData.isString() && newData.val().matches(/^(dictionary-search|camera-ocr)$/)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "wordRequestQuota": {
      ".read": true,
      "used": {
        ".write": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && data.val() < 2000 && newData.val() === data.val() + 1))",
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2000"
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
