{
  "name": "study-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run check:content && npm run audit:content-ledger",
    "check:content": "npm run audit:secrets && npm run audit:public-data && npm run check:deployment && npm run check:learner-contract && npm run audit:japanese && npm run audit:curriculum-1900 && node scripts/check-data.mjs && npm run audit:idiom-forms && npm run audit:etymology-quality && node scripts/english-content-audit.mjs && npm run audit:grammar-explanations && npm run audit:reading-translations && npm run audit:extended-reading && npm run audit:question-formats && npm run audit:classics-kanbun && npm run audit:normal-learning-record-lists && npm run audit:notebook && npm run audit:analytics && npm run audit:phrases && npm run audit:xp-retirement && npm run audit:content-progress && npm run audit:links",
    "check:deployment": "node scripts/check-deployment-target.mjs",
    "check:learner-contract": "node scripts/check-learner-facing-contract.mjs",
    "audit:japanese": "node scripts/audit-learner-japanese.mjs",
    "audit:english": "node scripts/english-content-audit.mjs",
    "audit:grammar-explanations": "node scripts/audit-grammar-explanations.mjs",
    "audit:reading-translations": "node scripts/audit-reading-translations.mjs",
    "audit:extended-reading": "node scripts/audit-extended-reading.mjs",
    "audit:question-formats": "node scripts/audit-english-question-formats.mjs",
    "audit:content-ledger": "node scripts/content-audit-ledger.mjs",
    "audit:all-content": "node scripts/record-content-audit.mjs",
    "audit:classics-kanbun": "node scripts/check-classics-kanbun.mjs",
    "audit:normal-learning-record-lists": "node scripts/check-normal-learning-record-lists.mjs",
    "audit:notebook": "node scripts/check-learning-notebook.mjs",
    "audit:analytics": "node scripts/check-learning-analytics.mjs",
    "audit:content-progress": "node scripts/check-content-progress.mjs",
    "audit:etymology-quality": "node scripts/check-etymology-learning-quality.mjs",
    "audit:links": "node scripts/check-learning-links.mjs",
    "audit:dist": "node scripts/audit-public-secrets.mjs --directory dist",
    "audit:public-data": "node scripts/check-public-data-security.mjs",
    "audit:secrets": "node scripts/audit-public-secrets.mjs",
    "audit:phrases": "node scripts/audit-phrase-explanations.mjs",
    "audit:idiom-forms": "node scripts/check-idiom-form-families.mjs",
    "audit:curriculum-1900": "node scripts/audit-curriculum-1900.mjs",
    "audit:xp-retirement": "node scripts/check-xp-retirement.mjs",
    "prebuild": "npm run check",
    "build": "vite build",
    "postbuild": "npm run audit:dist",
    "generate:battle-motion": "node scripts/generate-battle-motion.mjs",
    "preview": "vite preview",
    "vocab": "node scripts/vocab-report.mjs",
    "etymology": "node scripts/etymology-report.mjs && npm run audit:etymology-quality",
    "map": "node scripts/vocab-map.mjs",
    "decks": "node scripts/deck-report.mjs",
    "scaffold": "node scripts/frontier-scaffold.mjs",
    "import": "node scripts/import-words.mjs",
    "phonetics": "node scripts/gen-phonetics.mjs",
    "grammar": "node scripts/grammar-report.mjs",
    "dictionary": "node scripts/dictionary-report.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.0",
    "firebase": "^12.14.0",
    "jsqr": "^1.4.0",
    "katex": "^0.17.0",
    "lz-string": "^1.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "playwright": "^1.61.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16"
  }
}
