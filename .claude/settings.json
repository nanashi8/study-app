{
  "env": {
    "GIT_AUTHOR_NAME": "nanashi8",
    "GIT_AUTHOR_EMAIL": "nanashi8@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "nanashi8",
    "GIT_COMMITTER_EMAIL": "nanashi8@users.noreply.github.com",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.hooksPath",
    "GIT_CONFIG_VALUE_0": "scripts/git-hooks"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-requests.mjs\" --prompt",
            "timeout": 30,
            "statusMessage": "依頼台帳を確認中"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-requests.mjs\" --edit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-requests.mjs\" --stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
